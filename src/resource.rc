#include <windows.h>
#include "resource.h"
#pragma code_page(65001)
IDI_APP ICON "LiteViewer.ico"
1 24 "manifest.xml"

IDR_MAINMENU MENU
BEGIN
  POPUP "ファイル"
  BEGIN
    MENUITEM "開く...\tCtrl+O", IDM_OPEN
    MENUITEM "再読み込み\tF5", IDM_RELOAD
    MENUITEM "画像をコピー\tCtrl+C", IDM_COPY
    MENUITEM "画像の情報\tI", IDM_IMAGEINFO
    MENUITEM SEPARATOR
    MENUITEM "終了\tEsc", IDM_EXIT
  END
  POPUP "表示"
  BEGIN
    MENUITEM "原寸 100%\t1", IDM_ACTUAL
    MENUITEM "縮小のみフィット\t2", IDM_SHRINK
    MENUITEM "全体フィット\t3", IDM_FIT
    MENUITEM "横幅フィット\t4", IDM_WIDTH
    MENUITEM "縦幅フィット\t5", IDM_HEIGHT
    MENUITEM "拡大\t+", IDM_ZOOMIN
    MENUITEM "縮小\t-", IDM_ZOOMOUT
    MENUITEM "ズーム固定\tCtrl+L", IDM_LOCK
    MENUITEM SEPARATOR
    MENUITEM "全画面\tF11", IDM_FULLSCREEN
    MENUITEM "シンプルモード\tF10", IDM_SIMPLE
  END
  POPUP "移動"
  BEGIN
    MENUITEM "前の画像\tLeft", IDM_PREV
    MENUITEM "次の画像\tRight", IDM_NEXT
    MENUITEM "最初\tUp", IDM_FIRST
    MENUITEM "最後\tDown", IDM_LAST
    POPUP "並べ替え"
    BEGIN
      MENUITEM "自然順", IDM_SORT_NATURAL
      MENUITEM "名前順", IDM_SORT_NAME
      MENUITEM "更新日時順", IDM_SORT_DATE
      MENUITEM "サイズ順", IDM_SORT_SIZE
      MENUITEM "降順にする", IDM_SORT_DESC
    END
  END
  POPUP "設定"
  BEGIN
    MENUITEM "表示設定...", IDM_SETTINGS
  END
  POPUP "ヘルプ"
  BEGIN
    MENUITEM "バージョン情報", IDM_ABOUT
  END
END

IDR_POPUPMENU MENU
BEGIN
  POPUP "画像操作"
  BEGIN
    MENUITEM "前の画像", IDM_PREV
    MENUITEM "次の画像", IDM_NEXT
    MENUITEM "画像をコピー (Ctrl+C)", IDM_COPY
    MENUITEM "画像の情報 (I)", IDM_IMAGEINFO
    MENUITEM SEPARATOR
    MENUITEM "原寸表示", IDM_ACTUAL
    MENUITEM "縮小のみフィット", IDM_SHRINK
    MENUITEM "全体フィット", IDM_FIT
    MENUITEM "全画面切替", IDM_FULLSCREEN
    MENUITEM "設定...", IDM_SETTINGS
    MENUITEM "終了", IDM_EXIT
  END
END

IDR_ACCELERATORS ACCELERATORS
BEGIN
  "O", IDM_OPEN, VIRTKEY, CONTROL
  "C", IDM_COPY, VIRTKEY, CONTROL
  "I", IDM_IMAGEINFO, VIRTKEY
  "L", IDM_LOCK, VIRTKEY, CONTROL
  VK_F5, IDM_RELOAD, VIRTKEY
  VK_F10, IDM_SIMPLE, VIRTKEY
  VK_F11, IDM_FULLSCREEN, VIRTKEY
  VK_RETURN, IDM_FULLSCREEN, VIRTKEY
  VK_ESCAPE, IDM_EXIT, VIRTKEY
  VK_LEFT, IDM_PREV, VIRTKEY
  VK_RIGHT, IDM_NEXT, VIRTKEY
  VK_UP, IDM_FIRST, VIRTKEY
  VK_DOWN, IDM_LAST, VIRTKEY
  "1", IDM_ACTUAL, VIRTKEY
  "2", IDM_SHRINK, VIRTKEY
  "3", IDM_FIT, VIRTKEY
  "4", IDM_WIDTH, VIRTKEY
  "5", IDM_HEIGHT, VIRTKEY
  VK_ADD, IDM_ZOOMIN, VIRTKEY
  VK_SUBTRACT, IDM_ZOOMOUT, VIRTKEY
END

IDD_SETTINGS DIALOGEX 0, 0, 255, 207
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "LiteViewer - 表示設定"
FONT 9, "MS Shell Dlg 2"
BEGIN
  LTEXT "初期倍率", -1, 12, 15, 75, 12
  COMBOBOX IDC_FIT, 93, 12, 150, 100, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
  LTEXT "背景", -1, 12, 47, 75, 12
  COMBOBOX IDC_BACKGROUND, 93, 44, 150, 90, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
  LTEXT "描画品質", -1, 12, 79, 75, 12
  COMBOBOX IDC_QUALITY, 93, 76, 150, 70, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
  CONTROL "ズーム固定", IDC_ZOOMLOCK, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 14, 115, 205, 13
  CONTROL "画像送りをループ", IDC_LOOP, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 14, 137, 205, 13
  DEFPUSHBUTTON "OK", IDOK, 124, 174, 55, 16
  PUSHBUTTON "キャンセル", IDCANCEL, 185, 174, 58, 16
END


// Image information: informational fields are readonly; all labels remain in RC.
IDD_IMAGEINFO DIALOGEX 0, 0, 370, 270
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "LiteViewer - 画像の情報"
FONT 9, "MS Shell Dlg 2"
BEGIN
  LTEXT "ファイル名", -1, 10, 15, 103, 13
  EDITTEXT IDC_INFO_FILENAME, 118, 12, 240, 15, ES_AUTOHSCROLL | ES_READONLY | WS_BORDER
  LTEXT "ファイルの場所", -1, 10, 38, 103, 13
  EDITTEXT IDC_INFO_DIRECTORY, 118, 35, 240, 15, ES_AUTOHSCROLL | ES_READONLY | WS_BORDER
  LTEXT "フルパス", -1, 10, 61, 103, 13
  EDITTEXT IDC_INFO_FULLPATH, 118, 58, 240, 15, ES_AUTOHSCROLL | ES_READONLY | WS_BORDER
  LTEXT "ファイル形式", -1, 10, 84, 103, 13
  EDITTEXT IDC_INFO_FORMAT, 118, 81, 240, 15, ES_AUTOHSCROLL | ES_READONLY | WS_BORDER
  LTEXT "元のサイズ", -1, 10, 107, 103, 13
  EDITTEXT IDC_INFO_ORIGINAL, 118, 104, 240, 15, ES_AUTOHSCROLL | ES_READONLY | WS_BORDER
  LTEXT "現在のサイズ", -1, 10, 130, 103, 13
  EDITTEXT IDC_INFO_CURRENT, 118, 127, 240, 15, ES_AUTOHSCROLL | ES_READONLY | WS_BORDER
  LTEXT "ディスク上のサイズ", -1, 10, 153, 103, 13
  EDITTEXT IDC_INFO_DISKSIZE, 118, 150, 240, 15, ES_AUTOHSCROLL | ES_READONLY | WS_BORDER
  LTEXT "メモリ上のサイズ", -1, 10, 176, 103, 13
  EDITTEXT IDC_INFO_MEMORYSIZE, 118, 173, 240, 15, ES_AUTOHSCROLL | ES_READONLY | WS_BORDER
  LTEXT "フォルダ内の順番", -1, 10, 199, 103, 13
  EDITTEXT IDC_INFO_POSITION, 118, 196, 240, 15, ES_AUTOHSCROLL | ES_READONLY | WS_BORDER
  LTEXT "ファイルの更新日時", -1, 10, 222, 103, 13
  EDITTEXT IDC_INFO_MODIFIED, 118, 219, 240, 15, ES_AUTOHSCROLL | ES_READONLY | WS_BORDER
  DEFPUSHBUTTON "OK", IDOK, 156, 245, 58, 17
END

STRINGTABLE
BEGIN
  IDS_CLIPBOARD_ERROR "表示中の画像をクリップボードにコピーできません。画像の読込完了後に再試行してください。"
  IDS_ABOUT "LiteViewer 1.5\nC11 / Win32 / WIC / GDI\n閲覧専用"
  IDS_SAVE_ERROR "INIを保存できませんでした。設定は今回の実行中だけ有効です。"
  IDS_WORKER_ERROR "画像読込スレッドを作成できません。"
END
